<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the bubble above other apps (granted by the user in Settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service, plus the Android 14 special-use flavor of it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The "bubble is on" notification (runtime prompt on Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice notes in the quick capture card (runtime prompt from the
         settings screen; recording happens only on an explicit mic tap). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets the boot receiver bring the bubble back after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets the app see launcher apps so it can find one labeled "Muse"
         without needing the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 14 foreground-service rules: type "specialUse" plus a
             declared subtype explaining what the persistent UI element is. -->
        <service
            android:name=".FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating shortcut button that stays on screen so the user can open Muse with one tap from inside any other app." />
        </service>

        <!-- Restarts the bubble after a reboot when it was left enabled.
             BOOT_COMPLETED is a protected system broadcast, so this
             receiver does not need to be exported. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Hands a recorded voice note to the app picked in the share
             chooser. Not exported: reachable only through the temporary
             read grant on the share intent. -->
        <provider
            android:name=".VoiceNoteProvider"
            android:authorities="net.northbrand.musefloat.voicenotes"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
